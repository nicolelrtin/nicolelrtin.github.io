---
import Layout from "../layouts/Layout.astro";

const description = "Nicole T. AI/ML R&D at Gilead Sciences.";
---

<Layout title="Home | Personal Website" description={description}>
    <section class="intro">
        <h1 class="hero-title">about.</h1>
        <p class="page-description">{description}</p>
    </section>
</Layout>

<style>
    .intro {
        margin-top: 0;
        margin-bottom: 4rem;
    }

    .hero-title {
        margin-bottom: 1rem;
    }

    .page-description {
        font-size: 1.2rem;
        color: var(--color-text-muted);
        max-width: 600px;
        margin-bottom: 3rem;
        line-height: 1.5;
    }
</style>

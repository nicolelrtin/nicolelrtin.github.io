---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Home | Personal Website">
	<section class="intro">
		<h1 class="hero-title">pages.</h1>
		<p class="bio">
			Hello. This is a minimal personal website where I log my thoughts and reading.
            Inspired by the clean aesthetics of modern typography.
		</p>
        <p class="bio">
            Built with <a href="https://astro.build">Astro</a> and vanilla CSS.
        </p>
	</section>
</Layout>

<style>
	.intro {
		margin-top: 4rem;
        margin-bottom: 6rem;
	}

    .hero-title {
        margin-bottom: 2rem;
    }

    .bio {
        font-size: 1.2rem;
        color: var(--color-text-muted);
        max-width: 600px;
        margin-bottom: 1.5rem;
    }
</style>

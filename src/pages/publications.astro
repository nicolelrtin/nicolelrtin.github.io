---
import Layout from "../layouts/Layout.astro";
import PostCard from "../components/PostCard.astro";
import { getCollection } from "astro:content";

const publications = (await getCollection("publications")).sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const title = "Publications";
const description = "peer-reviewed academic papers and abstracts.";
---

<Layout title={title} description={description}>
    <section>
        <h1 class="page-title">publications.</h1>
        <p class="page-description">{description}</p>
        <div class="pubs-list">
            {
                publications.length > 0 ? (
                    publications.map((pub) => (
                        <PostCard
                            title={pub.data.title}
                            description={pub.data.journal || ""}
                            pubDate={pub.data.pubDate}
                            href={pub.data.link || "#"}
                            image={pub.data.image}
                        />
                    ))
                ) : (
                    <p class="empty-state">No publications yet.</p>
                )
            }
        </div>
    </section>
</Layout>

<style>
    .page-title {
        margin-bottom: 1rem;
    }

    .page-description {
        font-size: 1.2rem;
        color: var(--color-text-muted);
        max-width: 600px;
        margin-bottom: 3rem;
        line-height: 1.5;
    }

    .pubs-list {
        max-width: 800px;
    }

    .empty-state {
        color: var(--color-text-muted);
        font-style: italic;
    }
</style>

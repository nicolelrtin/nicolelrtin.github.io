---
import { type CollectionEntry, getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
	const posts = await getCollection('pages');
	return posts.map((post) => ({
		params: { slug: post.slug },
		props: post,
	}));
}

type Props = CollectionEntry<'pages'>;

const post = Astro.props;
const { Content } = await post.render();
---

<Layout title={post.data.title} description={post.data.description}>
	<article class="post-layout">
        <aside class="post-sidebar">
            <!-- Sidebar content (footnotes/legend) will go here later -->
        </aside>
        <div class="post-main">
            <header class="post-header">
                <h1 class="post-title">{post.data.title}</h1>
                <div class="post-meta">
                    <time datetime={post.data.pubDate.toISOString()}>
                        {post.data.pubDate.toLocaleDateString('en-US', {
                            year: 'numeric',
                            month: 'long',
                            day: 'numeric',
                        })}
                    </time>
                    {post.data.tags && post.data.tags.length > 0 && (
                        <span class="tags-separator">•</span>
                        <div class="tags">
                            {post.data.tags.map(tag => (
                                <span class="tag">#{tag}</span>
                            ))}
                        </div>
                    )}
                </div>
            </header>
            <div class="content">
                <Content />
            </div>
        </div>
	</article>
</Layout>

<style>
    .post-layout {
        display: grid;
        grid-template-columns: 1fr; /* Default mobile */
        gap: 2rem;
        margin-top: 4rem;
    }

    @media (min-width: 768px) {
        .post-layout {
            grid-template-columns: 250px 1fr; /* Sidebar + Content */
            gap: 4rem;
        }
    }

    .post-sidebar {
        /* Future space for footnotes/TOC */
        display: none;
    }

    @media (min-width: 768px) {
        .post-sidebar {
            display: block;
        }
    }

    .post-main {
        max-width: 100%;
        min-width: 0; /* Prevent overflow */
    }

    .post-header {
        margin-bottom: 3rem;
        text-align: left;
    }

    .post-title {
        font-size: 3.5rem;
        margin-bottom: 1rem;
        line-height: 1.1;
        font-family: var(--font-serif);
    }

    .post-meta {
        color: var(--color-text-muted);
        font-family: 'Inter', sans-serif; /* Keep meta sans-serif for contrast */
        font-size: 0.95rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
        flex-wrap: wrap;
    }

    .tags {
        display: flex;
        gap: 0.5rem;
    }

    .tag {
        color: var(--color-text-muted);
    }
    
    .tags-separator {
        opacity: 0.5;
    }

    .content {
        font-family: 'EB Garamond', serif; /* Requested font */
        font-size: 1.25rem;
        line-height: 1.8;
        color: #1a1a1a; /* Slightly darker than pure black for readability */
        margin-bottom: 6rem;
    }

    /* Prose styling */
    .content :global(h2) {
        font-family: var(--font-serif);
        font-size: 2rem;
        margin-top: 3rem;
        margin-bottom: 1.5rem;
        font-weight: 300;
        color: var(--color-text-main);
    }
    
    .content :global(h3) {
        font-family: var(--font-serif);
        font-size: 1.5rem;
        margin-top: 2.5rem;
        margin-bottom: 1rem;
        font-weight: 300;
    }

    .content :global(p) {
        margin-bottom: 1.5rem;
    }

    .content :global(a) {
        text-decoration: underline;
        text-decoration-thickness: 1px;
        text-underline-offset: 4px;
        color: inherit;
    }
    
    .content :global(blockquote) {
        border-left: 3px solid #e5e5e5;
        padding-left: 1.5rem;
        margin: 2rem 0;
        font-style: italic;
        color: var(--color-text-muted);
    }
    
    .content :global(ul), .content :global(ol) {
        margin-bottom: 1.5rem;
        padding-left: 1.5rem;
    }
    
    .content :global(li) {
        margin-bottom: 0.5rem;
    }
</style>

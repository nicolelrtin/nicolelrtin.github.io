---
import { type CollectionEntry, getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
	const posts = await getCollection('pages');
	return posts.map((post) => ({
		params: { slug: post.slug },
		props: post,
	}));
}

type Props = CollectionEntry<'pages'>;

const post = Astro.props;
const { Content, headings } = await post.render();
---

<Layout title={post.data.title} description={post.data.description}>
	<article class="post-layout">
        <aside class="post-sidebar">
            <nav class="toc-container">
                {headings.length > 0 && (
                    <ul class="toc-list">
                        {headings.filter(h => h.depth <= 3).map(h => (
                            <li class={`toc-item toc-depth-${h.depth}`}>
                                <a href={`#${h.slug}`}>{h.text}</a>
                            </li>
                        ))}
                    </ul>
                )}
            </nav>
            <div id="sidebar-footnotes" class="sidebar-footnotes">
                <!-- Footnotes will be moved here by JS -->
            </div>
        </aside>
        <div class="post-main">
            <header class="post-header">
                <h1 class="post-title">{post.data.title}</h1>
                <div class="post-meta">
                    <time datetime={post.data.pubDate.toISOString()}>
                        {post.data.pubDate.toLocaleDateString('en-US', {
                            year: 'numeric',
                            month: 'long',
                            day: 'numeric',
                        })}
                    </time>
                    {post.data.tags && post.data.tags.length > 0 && (
                        <span class="tags-separator">•</span>
                        <div class="tags">
                            {post.data.tags.map(tag => (
                                <span class="tag">#{tag}</span>
                            ))}
                        </div>
                    )}
                </div>
            </header>
            <div class="content">
                <Content />
            </div>
        </div>
	</article>
</Layout>

<script>
    function repositionFootnotes() {
        // Look for footnotes from remark-gfm (section.footnotes)
        const originalFootnotes = document.querySelector('.footnotes');
        if (!originalFootnotes) {
            console.log('No footnotes found');
            return;
        }

        const sidebarContainer = document.getElementById('sidebar-footnotes');
        if (!sidebarContainer) return;
        
        // Clear existing sidebar footnotes locally to rebuild
        sidebarContainer.innerHTML = '';
        
        // Use visible dimensions of TOC
        const toc = document.querySelector('.toc-container') as HTMLElement;
        const tocHeight = toc ? toc.offsetHeight : 0;
        
        // IMPORTANT: Sticky offset. 
        // If TOC is sticky, its visual bottom depends on scroll.
        // But we need to place footnotes in "Static Layout Space" relative to the document.
        // The footnote should start AFTER the TOC *content* but also be aligned with text.
        // If TOC is short, we start searching for alignment.
        // We use a base offset that is at least TOC height + margin
        let layoutY = tocHeight + 40; 
        
        const footnoteItems = originalFootnotes.querySelectorAll('li');
        
        footnoteItems.forEach((item) => {
            // Astro/Remark GFM often uses IDs like 'user-content-fn-1'
            // We need to extract the ID part (e.g. '1') to find the reference
            const match = item.id.match(/(?:fn:|user-content-fn-)(.+)/);
            if (!match) return; // Skip if ID format is unexpected
            
            const id = match[1];
            
            // Search for the reference link in the body
            // ID formats: 'fnref:1' or 'user-content-fnref-1'
            let ref = document.getElementById(`fnref:${id}`) || document.getElementById(`user-content-fnref-${id}`);
            
            if (ref) {
                // Determine CSS top position relative to .post-sidebar
                const sidebar = document.querySelector('.post-sidebar');
                if (!sidebar) return;

                const sidebarRect = sidebar.getBoundingClientRect();
                const refRect = ref.getBoundingClientRect();
                
                // Absolute Y relative to the top of the sidebar container
                const relativeRefTop = (refRect.top + window.scrollY) - (sidebarRect.top + window.scrollY);
                
                // Calculate final top: Max of (Ref Position, Previous Element Bottom)
                const topPos = Math.max(relativeRefTop, layoutY);
                
                const newNote = document.createElement('div');
                newNote.className = 'sidebar-note';
                // Clean content: remove backrefs
                const contentClone = item.cloneNode(true) as HTMLElement;
                const backrefs = contentClone.querySelectorAll('.footnote-backref, .data-footnote-backref');
                backrefs.forEach(b => b.remove());
                
                newNote.innerHTML = `<span class="note-ref">${id}.</span> ${contentClone.innerHTML}`;
                newNote.style.top = `${topPos}px`;
                
                sidebarContainer.appendChild(newNote);
                
                // Update layoutY for next item: Current Top + Height + Margin
                // We must query height after append
                layoutY = topPos + newNote.offsetHeight + 16;
            }
        });
        
        // Hide original footnotes after successful move
        if (sidebarContainer.children.length > 0) {
             (originalFootnotes as HTMLElement).style.display = 'none';
        }
    }

    // Run on load and resize
    // We use a timeout to ensure layout is settled (images etc)
    window.addEventListener('load', () => setTimeout(repositionFootnotes, 100));
    window.addEventListener('resize', () => setTimeout(repositionFootnotes, 100));
    // Astro View Transitions compatibility (if enabled later)
    document.addEventListener('astro:page-load', repositionFootnotes);
</script>

<style>
    .post-layout {
        display: grid;
        grid-template-columns: 1fr; /* Default mobile */
        gap: 2rem;
        margin-top: 4rem;
        position: relative;
    }

    @media (min-width: 900px) {
        .post-layout {
            grid-template-columns: 20% 1fr; /* Reduced width to bring text closer */
            gap: 2rem; /* Reduced gap from 4rem */
        }
    }

    .post-sidebar {
        /* Mobile: Hidden or bottom? User asked for sidebar behavior. 
           We'll hide TOC on mobile usually, or put it on top. 
           For now, display: none on mobile as per previous CSS 
        */
        display: none;
        position: relative; /* Context for absolute footnotes */
        height: 100%; /* Fill grid height */
    }

    @media (min-width: 900px) {
        .post-sidebar {
            display: block;
        }
    }
    
    .toc-container {
        position: sticky; /* Make TOC sticky */
        top: 2rem;
        max-height: calc(100vh - 4rem); /* Prevent overflow */
        overflow-y: auto;
        
        margin-bottom: 2rem;
        font-family: 'Helvetica Light', 'Helvetica', sans-serif;
        font-size: 0.9rem;
        z-index: 10; /* Above text if overlap? */
    }
    
    .toc-list {
        list-style: none;
        padding: 0;
        margin: 0;
    }
    
    .toc-item {
        margin-bottom: 0.5rem;
    }
    
    .toc-item a {
        text-decoration: none;
        color: var(--color-text-muted);
        transition: color 0.2s;
        display: block; /* Clicking area */
    }
    
    .toc-item a:hover {
        color: var(--color-text-main);
    }
    
    .toc-depth-3 {
        padding-left: 1rem;
        font-size: 0.85rem;
    }
    
    .sidebar-footnotes {
        position: static; /* Children are absolute relative to .post-sidebar */
        width: 100%;
        margin-top: 1rem;
    }
    
    /* Global style to style the JS-created notes */
    :global(.sidebar-note) {
        position: absolute; /* Relative to .post-sidebar */
        width: 100%;
        left: 0;
        font-size: 0.8rem;
        color: var(--color-text-muted);
        font-family: var(--font-sans);
        line-height: 1.4;
        transition: top 0.3s ease;
        
        /* Box styling */
        padding-top: 0.5rem;
        border-top: 1px solid #eee;
    }
    
    :global(.sidebar-note p) {
        margin: 0;
        display: inline;
    }
    
    :global(.note-ref) {
        font-weight: 600;
        margin-right: 0.25rem;
    }

    .post-main {
        max-width: 100%;
        min-width: 0;
    }

    .post-header {
        margin-bottom: 3rem;
        text-align: left;
    }

    .post-title {
        font-size: 3.5rem;
        margin-bottom: 1rem;
        line-height: 1.1;
        font-family: var(--font-serif);
    }

    .post-meta {
        color: var(--color-text-muted);
        font-family: 'Inter', sans-serif;
        font-size: 0.95rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
        flex-wrap: wrap;
    }

    .tags {
        display: flex;
        gap: 0.5rem;
    }

    .tag {
        color: var(--color-text-muted);
    }
    
    .tags-separator {
        opacity: 0.5;
    }

    .content {
        font-family: 'EB Garamond', serif;
        font-size: 1.25rem;
        line-height: 1.6; /* Reduced from 1.8 */
        color: #1a1a1a;
        margin-bottom: 6rem;
    }
    
    /* Initially hide footnotes but allow JS to find them */
    /* If we use display:none, JS can't measure children height? 
       Yes it can if checking innerHTML and creating new elements. 
       But original footnotes are safe to hide visually. */
    .content :global(.footnotes) {
        visibility: hidden; /* Hide but keep layout for JS measurement? No, we clone. */
        height: 0;
        overflow: hidden;
    }

    .content :global(h1) {
        font-family: 'Helvetica Light', 'Helvetica', sans-serif;
        font-style: normal;
        font-weight: 300;
        font-size: 1.8rem; /* Reduced from 2.5rem */
        margin-top: 2rem;
        margin-bottom: 1rem;
        color: var(--color-text-main);
    }

    .content :global(h2) {
        font-family: 'Helvetica', sans-serif; /* Unitalicized Helvetica */
        font-weight: 400; /* Regular weight for Helvetica */
        font-style: normal;
        font-size: 1.5rem; /* Reduced from 2.25rem */
        margin-top: 2rem; /* Reduced spacing */
        margin-bottom: 0.75rem; /* Reduced spacing */
        color: var(--color-text-main);
    }
    
    .content :global(h3) {
        font-family: 'Helvetica Light', 'Helvetica', sans-serif;
        font-weight: 300;
        font-style: italic; /* Italicized */
        font-size: 1.5rem; /* ~1 size larger than 1.25rem */
        margin-top: 1.75rem; /* Reduced spacing */
        margin-bottom: 0.5rem;
    }

    .content :global(p) {
        margin-bottom: 1.25rem; /* Slightly reduced paragraph spacing to match tighter feel */
    }

    .content :global(a) {
        text-decoration: underline;
        text-decoration-thickness: 1px;
        text-underline-offset: 4px;
        color: inherit;
    }
    
    .content :global(blockquote) {
        border-left: 3px solid #e5e5e5;
        padding-left: 1.5rem;
        margin: 2rem 0;
        font-style: italic;
        color: var(--color-text-muted);
    }
    
    .content :global(ul), .content :global(ol) {
        margin-bottom: 1.5rem;
        padding-left: 1.5rem;
    }
    
    .content :global(li) {
        margin-bottom: 0.5rem;
    }

    .content :global(table) {
        margin: 2rem auto; /* Center table */
        border-collapse: collapse;
    }

    .content :global(th), .content :global(td) {
        padding: 0.5rem 1.5rem; /* Increase horizontal padding */
        text-align: center; /* Center align text */
        border-bottom: 1px solid #e5e5e5; /* Add subtle border for readability */
        font-size: 1rem; /* Just larger than sidebar text (0.9rem), smaller than body (1.25rem) */
    }

    .content :global(th) {
        font-weight: 600;
        border-bottom: 2px solid #e5e5e5;
    }
</style>

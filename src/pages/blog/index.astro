---
import Layout from "../../layouts/Layout.astro";
import ListItem from "../../components/ListItem.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("pages")).sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

function getPreview(content: string) {
    // Remove markdown symbols and extra whitespace
    const stripped = content
        .replace(/[#*`_]/g, "")
        .replace(/\[(.*?)\]\(.*?\)/g, "$1")
        .replace(/\n+/g, " ")
        .trim();
    return stripped.length > 200
        ? stripped.substring(0, 200) + "..."
        : stripped;
}

const title = "Blog";
const description =
    "a collection of opinions, including book reviews and personal philosophies.";
---

<Layout title={title} description={description}>
    <section>
        <h1 class="page-title">Blog</h1>
        <p class="page-description">{description}</p>

        <div class="list-header"></div>

        <div class="posts-list">
            <ListItem
                title="Guide to War and Peace"
                description="An interactive graph of the many characters and relationships (updated: Books I-XI)."
                preview=" "
                pubDate={new Date()}
                tags={["books", "tools"]}
                href="/blog/war-and-peace"
            />
            {
                posts.length > 0 ? (
                    posts.map((post) => (
                        <ListItem
                            title={post.data.title}
                            description={post.data.description}
                            preview={getPreview(post.body)}
                            pubDate={post.data.pubDate}
                            tags={post.data.tags}
                            href={`/blog/${post.slug}`}
                        />
                    ))
                ) : (
                    <p class="empty-state">No essays yet. Check back soon.</p>
                )
            }
        </div>
    </section>
</Layout>

<style>
    section {
        max-width: 800px;
        margin: 0 auto;
    }

    .page-title {
        margin-bottom: 1rem;
    }

    .page-description {
        font-size: 1rem;
        color: var(--color-text-muted);
        max-width: 600px;
        margin-bottom: 4rem;
        line-height: 1.5;
    }

    .list-header {
        border-top: 1px solid #e5e5e5;
        margin-bottom: 3rem;
    }

    .posts-list {
        display: flex;
        flex-direction: column;
    }

    .empty-state {
        color: var(--color-text-muted);
        font-style: italic;
    }
</style>

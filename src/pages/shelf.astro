---
import Layout from '../layouts/Layout.astro';
import PostCard from '../components/PostCard.astro';
import { getCollection } from 'astro:content';

const books = (await getCollection('shelf')).sort(
    (a, b) => b.data.dateRead.valueOf() - a.data.dateRead.valueOf()
);

const title = "Shelf";
---

<Layout title={title}>
    <section>
        <h1 class="page-title">shelf.</h1>
        <div class="books-list">
             {books.length > 0 ? (
                books.map((book) => (
                    <PostCard
                        title={book.data.title}
                        description={`by ${book.data.author}`}
                        subtext={book.data.rating ? `${"★".repeat(book.data.rating)}${"☆".repeat(5-book.data.rating)}` : ''}
                        href="#" 
                    />
                ))
            ) : (
                <p class="empty-state">Reading list is empty.</p>
            )}
        </div>
    </section>
</Layout>

<style>
    .page-title {
        margin-bottom: 3rem;
    }

    .books-list {
        max-width: 700px;
    }
    
    .empty-state {
        color: var(--color-text-muted);
        font-style: italic;
    }
</style>

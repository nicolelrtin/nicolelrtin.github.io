---
interface Props {
    title: string;
    description?: string;
    href: string;
    pubDate?: Date;
    tags?: string[];
}

const { title, description, href, pubDate, tags } = Astro.props;

const formattedDate = pubDate
    ? pubDate.toLocaleDateString("en-US", {
          year: "numeric",
          month: "short",
          day: "numeric",
      })
    : "";
---

<a href={href} class="list-item">
    <div class="content">
        <h3 class="title">{title}</h3>
        {description && <p class="description">{description}</p>}
        <div class="meta">
            {formattedDate && <span class="date">{formattedDate}</span>}
            {
                tags && tags.length > 0 && (
                    <span class="tags">
                        {tags.map((tag, index) => (
                            <span class="tag">
                                #{tag}
                                {index < tags.length - 1 ? " " : ""}
                            </span>
                        ))}
                    </span>
                )
            }
        </div>
    </div>
</a>

<style>
    .list-item {
        display: block;
        padding: 1.5rem 0;
        margin-bottom: 2rem;
        border-bottom: 1px solid rgba(0, 0, 0, 0.05); /* Subtle separator */
        transition: opacity 0.2s ease;
    }

    .list-item:last-child {
        border-bottom: none;
    }

    .list-item:hover {
        opacity: 0.7;
    }

    .title {
        font-size: 1.6rem;
        font-weight: 400;
        margin: 0 0 0.5rem 0;
        color: var(--color-text-main);
        line-height: 1.2;
        font-family: var(
            --font-serif
        ); /* Use serif for headers to match style */
    }

    .description {
        font-size: 1.1rem;
        color: var(--color-text-muted);
        margin: 0 0 1rem 0;
        line-height: 1.5;
        opacity: 0.8; /* Faded effect */
    }

    .meta {
        font-size: 0.9rem;
        color: #a3a3a3;
        font-family: var(--font-sans);
        display: flex;
        gap: 1.5rem;
        align-items: center;
    }

    .date {
        font-variant-numeric: tabular-nums;
    }

    .tags {
        display: flex;
        gap: 0.5rem;
    }

    .tag {
        color: #a3a3a3;
    }
</style>

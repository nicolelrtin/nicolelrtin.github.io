---
interface Props {
    title: string;
    description?: string;
    preview?: string;
    href: string;
    pubDate?: Date | string;
    tags?: string[];
}

const { title, description, preview, href, pubDate, tags } = Astro.props;

const formattedDate = pubDate
    ? typeof pubDate === "string"
        ? pubDate
        : pubDate.toLocaleDateString("en-US", {
              year: "numeric",
              month: "short",
              day: "numeric",
          })
    : "";
---

<a href={href} class="list-item">
    <div class="content">
        <h3 class="title">{title}</h3>
        {description && <p class="description">{description}</p>}
        {preview && <p class="preview">{preview}</p>}
        <div class="meta">
            {formattedDate && <span class="date">{formattedDate}</span>}
            {
                tags && tags.length > 0 && (
                    <span class="tags">
                        {tags.map((tag, index) => (
                            <span class="tag">
                                {tag}
                                {index < tags.length - 1 ? ", " : ""}
                            </span>
                        ))}
                    </span>
                )
            }
        </div>
    </div>
</a>

<style>
    .list-item {
        display: block;
        padding: 0;
        margin-bottom: 4rem; /* Generous spacing between entries */
        text-decoration: none;
        transition: opacity 0.2s ease;
    }

    .list-item:hover {
        opacity: 0.8;
    }

    .title {
        font-family: var(--font-serif);
        font-size: 1.4rem;
        font-weight: 600;
        margin: 0 0 0.5rem 0;
        color: var(--color-text-main);
        line-height: 1.2;
    }

    .description {
        font-size: 0.95rem;
        color: var(--color-text-main);
        margin: 0 0 0.25rem 0;
        line-height: 1.5;
        opacity: 0.7;
    }

    .preview {
        font-size: 0.95rem;
        color: var(--color-text-muted);
        margin: 0 0 1rem 0;
        line-height: 1.5;
        opacity: 0.6;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .meta {
        font-size: 0.75rem;
        color: var(--color-text-muted);
        font-family: var(--font-sans);
        display: flex;
        gap: 0.75rem;
        align-items: center;
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }

    .meta > span:not(:last-child)::after {
        content: "·";
        margin-left: 0.75rem;
        opacity: 0.5;
    }

    .tags {
        display: flex;
        gap: 0;
    }

    .tag {
        color: var(--color-text-muted);
    }
</style>

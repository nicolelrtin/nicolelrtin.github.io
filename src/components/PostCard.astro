---
interface Props {
	title: string;
	description?: string;
    href: string;
	pubDate?: Date;
    subtext?: string;
    image?: string;
}

const { title, description, href, pubDate, subtext, image } = Astro.props;

const formattedDate = pubDate ? pubDate.toLocaleDateString('en-US', {
	year: 'numeric',
	month: 'short',
	day: 'numeric',
}) : '';
---

<a href={href} class="card">
    {image && (
        <div class="card-image">
            <img src={image} alt={title} />
        </div>
    )}
    <div class="card-content">
        <h3 class="title">{title}</h3>
        {description && <p class="description">{description}</p>}
        <div class="meta">
            {formattedDate && <span class="date">{formattedDate}</span>}
            {subtext && <span class="subtext">{subtext}</span>}
        </div>
    </div>
</a>

<style>
    .card {
        display: flex;
        gap: 1.5rem;
        padding: 1.5rem;
        margin-bottom: 1.5rem;
        background-color: transparent;
        border-radius: 8px;
        transition: background-color 0.2s ease, transform 0.1s ease;
        align-items: flex-start;
    }

    .card:hover {
        background-color: rgba(0, 0, 0, 0.03);
        opacity: 1; /* Override global link opacity */
        transform: translateY(-1px);
    }
    
    .card-image {
        flex-shrink: 0;
        width: 100px;
        height: 100px;
        overflow: hidden;
        border-radius: 4px;
        background-color: #f0f0f0;
    }

    .card-image img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .card-content {
        flex: 1;
    }

    .title {
        font-size: 1.4rem;
        margin: 0 0 0.5rem 0;
        line-height: 1.3;
        color: var(--color-text-main);
    }

    .description {
        font-size: 1rem;
        color: var(--color-text-muted);
        margin: 0 0 1rem 0;
        line-height: 1.5;
    }

    .meta {
        font-size: 0.85rem;
        color: #a3a3a3;
        font-family: var(--font-sans);
        display: flex;
        gap: 1rem;
    }
    
    @media (max-width: 600px) {
        .card {
            flex-direction: column;
            gap: 1rem;
        }
        .card-image {
            width: 100%;
            height: 200px;
        }
    }
</style>

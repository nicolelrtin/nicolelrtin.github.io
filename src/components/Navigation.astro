---
const links = [
  { href: "/", label: "Home" },
  { href: "/blog", label: "Blog" },
  { href: "/bookshelf", label: "Bookshelf" },
  { href: "/publications", label: "Publications" },
];

const { pathname } = Astro.url;
---

<nav class="nav">
  <ul class="nav-list">
    {
      links.map((link) => (
        <li>
          <a
            href={link.href}
            class={
              pathname === link.href ||
              (link.href !== "/" && pathname.startsWith(link.href))
                ? "active"
                : ""
            }
          >
            {link.label}
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<style>
  .nav {
    margin-bottom: 2rem;
    padding-top: 1rem;
    display: flex; /* Allow the nav to size to content if needed, or alignment */
  }

  .nav-list {
    display: inline-flex; /* Make it pill-shaped wrapping content */
    gap: 0.25rem; /* Reduced gap for tighter look */
    list-style: none;
    padding: 0.25rem 0.5rem; /* Compact padding */
    margin: 0;

    background-color: #ffffff;
    border: 1px solid #e5e5e5;
    border-radius: 6px; /* Rectangular with slight rounding */
    box-shadow:
      0 4px 6px -1px rgba(0, 0, 0, 0.05),
      0 2px 4px -1px rgba(0, 0, 0, 0.03); /* Faint light gray top down drop shadow */
  }

  .nav-list li {
    display: flex;
    align-items: center;
  }

  .nav-list li a {
    font-size: 0.85rem; /* Smaller font size */
    font-weight: 400;
    color: var(--color-text-muted);
    text-decoration: none;
    padding: 0.25rem 0.5rem; /* Compact hit area */
    border-radius: 4px; /* Matches nav container style */
    transition:
      color 0.2s ease,
      background-color 0.2s ease;
  }

  .nav-list li a:hover {
    color: var(--color-text-main);
    background-color: #f5f5f5; /* Subtle hover background */
  }

  .nav-list li a.active {
    color: var(--color-text-main);
    /* font-weight: 600; Removed bold as requested */
  }
</style>
